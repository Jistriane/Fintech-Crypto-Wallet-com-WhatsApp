# Configuração para Deploy dos Contratos Notus
# IMPORTANTE: Nunca commite este arquivo com suas chaves reais!

# ===========================================
# ETHEREUM MAINNET CONFIGURATION
# ===========================================

# RPC Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# Alternativas:
# ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Private Key (NUNCA commite esta chave!)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Etherscan API Key (para verificação)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ===========================================
# GAS CONFIGURATION
# ===========================================

# Gas Price (em wei) - 20 Gwei = 20000000000
GAS_PRICE=20000000000

# Gas Limit (padrão: 8000000)
GAS_LIMIT=8000000

# Max Fee Per Gas (para EIP-1559)
MAX_FEE_PER_GAS=30000000000

# Max Priority Fee Per Gas (para EIP-1559)
MAX_PRIORITY_FEE_PER_GAS=2000000000

# ===========================================
# CONTRACT CONFIGURATION
# ===========================================

# Contract Owner (seu endereço de wallet)
CONTRACT_OWNER=0xYourWalletAddress

# Admin Address (para funções administrativas)
ADMIN_ADDRESS=0xYourWalletAddress

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Multi-sig Configuration (opcional)
MULTISIG_ADDRESS=0xYourMultisigAddress

# Pauser Address (para pausar contratos)
PAUSER_ADDRESS=0xYourWalletAddress

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================

# Network to deploy to
DEPLOY_NETWORK=mainnet

# Verify contracts after deployment
VERIFY_CONTRACTS=true

# Save deployment info
SAVE_DEPLOYMENT_INFO=true

# ===========================================
# MONITORING CONFIGURATION
# ===========================================

# Gas Reporter
REPORT_GAS=true

# Gas Reporter Currency
GAS_REPORTER_CURRENCY=USD

# CoinMarketCap API Key (para preços)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ===========================================
# TESTNET CONFIGURATION (para testes)
# ===========================================

# Goerli Testnet
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_PROJECT_ID
GOERLI_PRIVATE_KEY=your_goerli_private_key

# Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup deployment info
BACKUP_DEPLOYMENT=true

# Backup to IPFS (opcional)
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ===========================================
# NOTUS API INTEGRATION
# ===========================================

# Notus API Configuration
NOTUS_API_KEY=your_notus_api_key
NOTUS_SECRET_KEY=your_notus_secret_key
NOTUS_WEBHOOK_SECRET=your_notus_webhook_secret

# ===========================================
# IMPORTANT NOTES
# ===========================================

# 1. NUNCA commite este arquivo com chaves reais!
# 2. Use uma wallet separada para deploy
# 3. Mantenha backup das chaves privadas
# 4. Teste sempre em testnet primeiro
# 5. Monitore o gas antes do deploy
# 6. Salve os endereços dos contratos deployados
